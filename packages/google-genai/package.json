{
  "name": "@telemetry-dev/google-genai",
  "version": "0.1.3",
  "description": "Google GenAI (Gemini) SDK instrumentation for telemetry.dev: generation and embedding spans for @google/genai.",
  "keywords": [
    "gemini",
    "genai",
    "google",
    "llm",
    "observability",
    "opentelemetry",
    "telemetry",
    "tracing"
  ],
  "homepage": "https://telemetry.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telemetry-dev/sdks.git",
    "directory": "packages/google-genai"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec vp pack",
    "dev": "pnpm exec vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@google/genai": "2.10.0",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@telemetry-dev/sdk": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@google/genai": ">=2 <3",
    "@telemetry-dev/sdk": "workspace:^"
  }
}
