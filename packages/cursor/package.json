{
  "name": "@telemetry-dev/cursor",
  "version": "0.1.4",
  "description": "Cursor coding-agent telemetry integration for telemetry.dev.",
  "keywords": [
    "agents",
    "coding-agent",
    "cursor",
    "genai",
    "hooks",
    "llm",
    "observability",
    "opentelemetry",
    "telemetry",
    "tracing"
  ],
  "homepage": "https://telemetry.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telemetry-dev/sdks.git",
    "directory": "packages/cursor"
  },
  "bin": {
    "telemetry-dev-cursor": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./cli": {
      "bun": "./src/cli.ts",
      "types": "./src/cli.ts",
      "development": "./src/cli.ts",
      "default": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./cli": {
        "types": "./dist/cli.d.mts",
        "import": "./dist/cli.mjs",
        "default": "./dist/cli.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec vp pack && pnpm exec vp fmt dist --write",
    "dev": "pnpm exec vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@telemetry-dev/sdk": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "typescript": "^6.0.2",
    "vite-plus": "0.1.20",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
