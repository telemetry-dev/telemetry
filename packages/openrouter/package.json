{
  "name": "@telemetry-dev/openrouter",
  "version": "0.1.5",
  "description": "OpenRouter SDK instrumentation for telemetry.dev: generation and embedding spans for the official @openrouter/sdk package.",
  "keywords": [
    "genai",
    "llm",
    "observability",
    "openrouter",
    "opentelemetry",
    "telemetry",
    "tracing"
  ],
  "homepage": "https://telemetry.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telemetry-dev/telemetry.git",
    "directory": "packages/openrouter"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec vp pack",
    "dev": "pnpm exec vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@telemetry-dev/otel": "workspace:^"
  },
  "devDependencies": {
    "@openrouter/sdk": "1.1.2",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@telemetry-dev/sdk": "workspace:*",
    "@types/node": "^25.5.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@openrouter/sdk": ">=1.1.2 <2",
    "@telemetry-dev/sdk": "workspace:^"
  }
}
