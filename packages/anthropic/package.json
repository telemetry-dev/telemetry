{
  "name": "@telemetry-dev/anthropic",
  "version": "0.2.6",
  "description": "Anthropic SDK instrumentation for telemetry.dev: wraps the Messages API and emits OpenTelemetry GenAI spans.",
  "keywords": [
    "anthropic",
    "claude",
    "genai",
    "llm",
    "observability",
    "opentelemetry",
    "telemetry",
    "tracing"
  ],
  "homepage": "https://telemetry.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telemetry-dev/telemetry.git",
    "directory": "packages/anthropic"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm exec vp pack",
    "dev": "pnpm exec vp pack --watch",
    "test": "cross-env ANTHROPIC_SDK_VERSION=1 vp test && cross-env ANTHROPIC_SDK_VERSION=0 vp test",
    "check": "vp check",
    "check:v0": "tsc --project tsconfig.v0.json",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@telemetry-dev/sdk": "workspace:*",
    "@types/node": "catalog:",
    "anthropic-sdk-v0": "npm:@anthropic-ai/sdk@0.126.0",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.110.0 <2",
    "@telemetry-dev/sdk": "workspace:^"
  }
}
